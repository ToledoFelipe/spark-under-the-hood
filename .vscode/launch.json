{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Debug Current File (Spark cluster)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "SPARK_MASTER_URL": "spark://spark-master:7077"
            }
        }
    ]
}
